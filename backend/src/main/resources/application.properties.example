spring.application.name=donation

# 공공데이터포털 API 설정
public.api.key=YOUR_PUBLIC_DATA_API_KEY
public.api.url=http://openapi.1365.go.kr/openapi/service/rest/ContributionGroupService/getCntrProgramList

# MyBatis 설정 (DB 연동)
spring.datasource.url=jdbc:mysql://localhost:3306/donation?serverTimezone=UTC&useUnicode=true&characterEncoding=utf8
spring.datasource.username=YOUR_DB_USERNAME
spring.datasource.password=YOUR_DB_PASSWORD
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# MyBatis Mapper XML 경로
mybatis.mapper-locations=classpath:mapper/*.xml

# MyBatis camelCase 자동 변환 (snake_case 컬럼 → camelCase 필드)
mybatis.configuration.map-underscore-to-camel-case=true

# Spring Batch
spring.batch.jdbc.initialize-schema=always
spring.batch.job.enabled=false

# 토스페이먼츠 시크릿 키
# ⚠️ 클라이언트 키(frontend/src/lib/toss.js)와 반드시 같은 쌍이어야 승인됨
toss.secret-key=YOUR_TOSS_SECRET_KEY
toss.confirm-url=https://api.tosspayments.com/v1/payments/confirm
# 결제 취소(환불) 베이스 URL — 실제 호출 시 /{paymentKey}/cancel 이 붙음
toss.cancel-url=https://api.tosspayments.com/v1/payments

# JWT 설정 (32자 이상의 임의 문자열)
jwt.secret=YOUR_JWT_SECRET_AT_LEAST_32_CHARACTERS

# LLM API (OpenAI 호환)
# Spring AI가 base-url 뒤에 /v1/chat/completions, /v1/embeddings를 붙여서 호출함
spring.ai.openai.base-url=https://api.openai.com
spring.ai.openai.api-key=YOUR_OPENAI_API_KEY
spring.ai.openai.chat.options.model=gpt-5.4-mini
spring.ai.openai.embedding.options.model=text-embedding-3-large

# Gemini (사용 보고 AI 초안 생성용) — generativelanguage 경로, 인증은 x-goog-api-key 헤더
gemini.base-url=https://generativelanguage.googleapis.com
gemini.api-key=YOUR_GEMINI_API_KEY
gemini.model=gemini-3.5-flash

# 카카오 OAuth (developers.kakao.com 앱의 REST API 키)
kakao.rest-api-key=YOUR_KAKAO_REST_API_KEY

# 챗봇용 Redis Vector Store (redis/redis-stack 컨테이너)
chatbot.redis.host=localhost
chatbot.redis.port=6379

# Redis 캐시 (통계 대시보드 응답 캐싱) — 벡터 스토어와 동일 인스턴스 사용
spring.data.redis.host=localhost
spring.data.redis.port=6379

# 메일 발송 (Gmail SMTP) — 회원가입 이메일 인증 / 비밀번호 재설정 코드 발송용
# Gmail 2단계 인증을 켠 뒤 '앱 비밀번호' 16자리를 발급받아 MAIL_PASSWORD 로 주입한다.
# 환경변수: MAIL_USERNAME=보내는_지메일주소, MAIL_PASSWORD=앱_비밀번호(공백 제거)
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=${MAIL_USERNAME:}
spring.mail.password=${MAIL_PASSWORD:}
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
spring.mail.properties.mail.smtp.connectiontimeout=5000
spring.mail.properties.mail.smtp.timeout=5000
spring.mail.properties.mail.smtp.writetimeout=5000
app.mail.from=${MAIL_USERNAME:}

# 파일 업로드 설정
# 업로드 파일 저장 디렉터리 (서버 로컬 디스크). 없으면 서버 기동 시 자동 생성됨.
app.upload.dir=C:/donation/uploads
# 멀티파트 업로드 용량 제한
spring.servlet.multipart.max-file-size=5MB
spring.servlet.multipart.max-request-size=20MB
